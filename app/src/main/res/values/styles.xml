<resources>
    <style name="AppTheme" parent="android:style/Theme.Material.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:colorAccent">#38DFD8</item>
        <item name="android:colorControlActivated">#38DFD8</item>
        <item name="android:colorControlHighlight">#338B5CFF</item>
        <item name="android:textColorPrimary">#F1F7FF</item>
        <item name="android:textColorSecondary">#A3C5C6</item>
        <item name="android:alertDialogTheme">@style/PremiumAlertDialog</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowBackground">#05262D</item>
        <item name="android:windowNoTitle">true</item>
    </style>

    <style name="PremiumAlertDialog" parent="android:style/Theme.Material.Dialog.Alert">
        <item name="android:fontFamily">sans</item>
        <item name="android:colorAccent">#38DFD8</item>
        <item name="android:colorControlActivated">#38DFD8</item>
        <item name="android:textColorPrimary">#F1F7FF</item>
        <item name="android:textColorSecondary">#A3C5C6</item>
        <item name="android:windowBackground">@drawable/dialog_background</item>
        <item name="android:windowMinWidthMajor">88%</item>
        <item name="android:windowMinWidthMinor">88%</item>
        <item name="android:backgroundDimEnabled">true</item>
        <item name="android:backgroundDimAmount">0.72</item>
        <item name="android:windowAnimationStyle">@style/PremiumWindowAnimation</item>
    </style>

    <style name="PremiumWindowAnimation">
        <item name="android:windowEnterAnimation">@anim/premium_window_enter</item>
        <item name="android:windowExitAnimation">@anim/premium_window_exit</item>
    </style>

    <color name="icon_background">#05262D</color>
</resources>
